DATABASE_URL=postgresql://legalrag:legalrag@localhost:5432/legalrag
DEEPSEEK_API_KEY=

# Read by compose.yaml (the server stack); on the server this file has mode 600 and is never in git.
POSTGRES_PASSWORD=
TRACE_SECRET=
# Model provider of the service; all empty means DeepSeek with DEEPSEEK_API_KEY. The model needs a row in llm.PRICES.
# LLM_THINKING_OFF is a JSON object sent with each call ({} for none); in a .env file put it in single quotes.
# LLM_API_KEY=
# LLM_BASE_URL=            # Scaleway: https://api.scaleway.ai/<project id>/v1
# LLM_MODEL=               # Scaleway: deepseek-v4.1-flash-1017
# LLM_THINKING_OFF=        # Scaleway: '{"reasoning_effort": "none"}'; DeepSeek (the default): '{"thinking": {"type": "disabled"}}'
# HTTP_PORT=80
# CODE_VERSION=dev
# Backup to an S3-compatible bucket (Scaleway Object Storage, Paris); the passphrase encrypts the backups, keep a copy elsewhere.
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=https://s3.fr-par.scw.cloud
# BACKUP_S3_REGION=fr-par
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_PASSPHRASE=
